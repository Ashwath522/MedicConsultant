# Copy to .env and fill in.
# SQLite works out of the box. For Supabase/Postgres use:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./consultkeeper.db

# Change this to a long random string
JWT_SECRET=change-me

# Frontend origin(s), comma separated
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,ionic://localhost

# Optional: free Gemini key from https://aistudio.google.com (mock/de-identified data only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Speech-to-text (faster-whisper, local): tiny | base | small | medium
WHISPER_MODEL=small
MAX_AUDIO_MB=50
# Privacy default: audio is deleted right after transcription
KEEP_AUDIO=false
